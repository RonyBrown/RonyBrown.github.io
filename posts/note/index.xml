<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Blog</title><link>http://0.0.0.0:1313/posts/note/</link><description>Recent content on Blog</description><generator>Hugo</generator><language>en</language><copyright>Rony Brown's Blog</copyright><lastBuildDate>Thu, 20 Aug 2026 17:08:57 +0800</lastBuildDate><atom:link href="http://0.0.0.0:1313/posts/note/index.xml" rel="self" type="application/rss+xml"/><item><title>notepad++使用方法</title><link>http://0.0.0.0:1313/posts/note/edit/RZ_notepadpp_note/</link><pubDate>Sat, 26 Jul 2025 14:42:23 +0800</pubDate><guid>http://0.0.0.0:1313/posts/note/edit/RZ_notepadpp_note/</guid><description>&lt;h1 id="notepad使用方法"&gt;Notepad++使用方法&lt;a class="anchor" href="#notepad%e4%bd%bf%e7%94%a8%e6%96%b9%e6%b3%95"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;h2 id="软件设置"&gt;软件设置&lt;a class="anchor" href="#%e8%bd%af%e4%bb%b6%e8%ae%be%e7%bd%ae"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;h3 id="插件配置"&gt;插件配置&lt;a class="anchor" href="#%e6%8f%92%e4%bb%b6%e9%85%8d%e7%bd%ae"&gt;#&lt;/a&gt;&lt;/h3&gt;&#10;&lt;h4 id="nppexec"&gt;NppExec&lt;a class="anchor" href="#nppexec"&gt;#&lt;/a&gt;&lt;/h4&gt;&#10;&lt;p&gt;NppExec是一款支持在notepad++运行代码的插件。&lt;/p&gt;&#10;&lt;p&gt;按下F6运行代码，按下CTRL+F6执行上一次配置选项。&lt;/p&gt;&#10;&lt;h3 id="配置vhdl开发环境"&gt;配置VHDL开发环境&lt;a class="anchor" href="#%e9%85%8d%e7%bd%aevhdl%e5%bc%80%e5%8f%91%e7%8e%af%e5%a2%83"&gt;#&lt;/a&gt;&lt;/h3&gt;</description></item><item><title>Markdown 笔记</title><link>http://0.0.0.0:1313/posts/note/markdown/markdown-note/</link><pubDate>Wed, 08 Jan 2025 15:09:41 +0800</pubDate><guid>http://0.0.0.0:1313/posts/note/markdown/markdown-note/</guid><description>&lt;h1 id="markdown常用方法"&gt;Markdown常用方法&lt;a class="anchor" href="#markdown%e5%b8%b8%e7%94%a8%e6%96%b9%e6%b3%95"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;h2 id="页面"&gt;页面&lt;a class="anchor" href="#%e9%a1%b5%e9%9d%a2"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;h3 id="页面内跳转"&gt;页面内跳转&lt;a class="anchor" href="#%e9%a1%b5%e9%9d%a2%e5%86%85%e8%b7%b3%e8%bd%ac"&gt;#&lt;/a&gt;&lt;/h3&gt;&#10;&lt;p&gt;页面内跳转有两种方法：&lt;/p&gt;&#10;&lt;ol&gt;&#10;&lt;li&gt;锚点&lt;/li&gt;&#10;&lt;li&gt;目录&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;h4 id="锚点"&gt;锚点&lt;a class="anchor" href="#%e9%94%9a%e7%82%b9"&gt;#&lt;/a&gt;&lt;/h4&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f7f7f7;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-html" data-lang="html"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#1f2328"&gt;&amp;lt;&lt;/span&gt;&lt;span style="color:#0550ae"&gt;a&lt;/span&gt; &lt;span style="color:#1f2328"&gt;id&lt;/span&gt;&lt;span style="color:#0550ae"&gt;=&lt;/span&gt;&lt;span style="color:#0a3069"&gt;&amp;#34;target_pos&amp;#34;&lt;/span&gt;&lt;span style="color:#1f2328"&gt;&amp;gt;&amp;lt;/&lt;/span&gt;&lt;span style="color:#0550ae"&gt;a&lt;/span&gt;&lt;span style="color:#1f2328"&gt;&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#57606a"&gt;&amp;lt;!-- 方法一 --&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#1f2328"&gt;&amp;lt;&lt;/span&gt;&lt;span style="color:#0550ae"&gt;a&lt;/span&gt; &lt;span style="color:#1f2328"&gt;href&lt;/span&gt;&lt;span style="color:#0550ae"&gt;=&lt;/span&gt;&lt;span style="color:#0a3069"&gt;&amp;#34;#target_pos&amp;#34;&lt;/span&gt;&lt;span style="color:#1f2328"&gt;&amp;gt;&lt;/span&gt;点击跳转&lt;span style="color:#1f2328"&gt;&amp;lt;/&lt;/span&gt;&lt;span style="color:#0550ae"&gt;a&lt;/span&gt;&lt;span style="color:#1f2328"&gt;&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#57606a"&gt;&amp;lt;!-- 方法二 --&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[点击跳转](#target_pos)&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;&lt;strong&gt;示例：&lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;&lt;a id="target_pos"&gt;目的位置&lt;/a&gt;&lt;/p&gt;&#10;&lt;p&gt;&amp;mdash;&amp;mdash;&amp;ndash;分割线&amp;mdash;&amp;mdash;&amp;mdash;&lt;/p&gt;&#10;&lt;p&gt;&amp;mdash;&amp;mdash;&amp;ndash;分割线&amp;mdash;&amp;mdash;&amp;mdash;&lt;/p&gt;&#10;&lt;p&gt;&amp;mdash;&amp;mdash;&amp;ndash;分割线&amp;mdash;&amp;mdash;&amp;mdash;&lt;/p&gt;&#10;&lt;p&gt;&amp;mdash;&amp;mdash;&amp;ndash;分割线&amp;mdash;&amp;mdash;&amp;mdash;&lt;/p&gt;&#10;&lt;p&gt;&amp;mdash;&amp;mdash;&amp;ndash;分割线&amp;mdash;&amp;mdash;&amp;mdash;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;方法一：&lt;a href="#target_pos"&gt;点击跳转&lt;/a&gt;&lt;/li&gt;&#10;&lt;li&gt;方法二：&lt;del&gt;[点击跳转](#target_pos)&lt;/del&gt;&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;注：通过方法二跳转方法，Hugo生成的页面无法跳转&lt;/p&gt;&#10;&lt;h4 id="目录"&gt;目录&lt;a class="anchor" href="#%e7%9b%ae%e5%bd%95"&gt;#&lt;/a&gt;&lt;/h4&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f7f7f7;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-Markdown" data-lang="Markdown"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;# 目录1&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;## 目录2&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[&lt;span style="color:#0550ae"&gt;点击跳转目录1&lt;/span&gt;](&lt;span style="color:#1f2328"&gt;#目录1&lt;/span&gt;)&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[&lt;span style="color:#0550ae"&gt;点击跳转目录2&lt;/span&gt;](&lt;span style="color:#1f2328"&gt;#目录2&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;通过打锚点的方式也可以实现目录跳转&lt;/p&gt;&#10;&lt;h4 id="注脚跳转"&gt;注脚跳转&lt;sup id="fnref:1"&gt;&lt;a href="#fn:1" class="footnote-ref" role="doc-noteref"&gt;1&lt;/a&gt;&lt;/sup&gt;&lt;a class="anchor" href="#%e6%b3%a8%e8%84%9a%e8%b7%b3%e8%bd%ac"&gt;#&lt;/a&gt;&lt;/h4&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f7f7f7;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-markdown" data-lang="markdown"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;目的位置[^1]&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[^1]:点击跳转到注脚1处&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;div class="footnotes" role="doc-endnotes"&gt;&#10;&lt;hr&gt;&#10;&lt;ol&gt;&#10;&lt;li id="fn:1"&gt;&#10;&lt;p&gt;点击跳转到注脚1处&amp;#160;&lt;a href="#fnref:1" class="footnote-backref" role="doc-backlink"&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;/div&gt;</description></item><item><title>Git Page Note</title><link>http://0.0.0.0:1313/posts/note/git/git-page-note/</link><pubDate>Thu, 26 Dec 2024 15:09:41 +0800</pubDate><guid>http://0.0.0.0:1313/posts/note/git/git-page-note/</guid><description>&lt;h1 id="hugo构建github-pages"&gt;Hugo构建GitHub Pages&lt;a class="anchor" href="#hugo%e6%9e%84%e5%bb%bagithub-pages"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;h2 id="hugo--github-pages-搭建个人博客"&gt;Hugo + GitHub Pages 搭建个人博客&lt;a class="anchor" href="#hugo--github-pages-%e6%90%ad%e5%bb%ba%e4%b8%aa%e4%ba%ba%e5%8d%9a%e5%ae%a2"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;h3 id="创建-hugo-网站"&gt;创建 Hugo 网站&lt;a class="anchor" href="#%e5%88%9b%e5%bb%ba-hugo-%e7%bd%91%e7%ab%99"&gt;#&lt;/a&gt;&lt;/h3&gt;&#10;&lt;p&gt;通过上述命令安装 hugo 程序后，就可以通过 hugo new site 命令进行网站创建、配置与本地调试了。&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f7f7f7;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;hugo new site ronyz-site&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;注：后续命令未经说明，均在cmd中的ronyz-site根目录下运行&lt;/p&gt;&#10;&lt;p&gt;创建完成后，根目录 ronyz-site 包含以下文件&lt;/p&gt;&#10;&lt;pre tabindex="0"&gt;&lt;code&gt;.&#13;&#10;├── archetypes: default.md是生成博文的模版&#13;&#10;├── assets # 存放被 Hugo Pipes 处理的文件&#13;&#10;├── content # 存放markdown文件作为博文内容&#13;&#10;├── data # 存放 Hugo 处理的数据&#13;&#10;├── layouts # 存放布局文件&#13;&#10;├── static # 存放静态文件 图片 CSS JS文件&#13;&#10;├── themes: 存放不同的主题&#13;&#10;└── config.toml: 博客配置文件支持 JSON YAML TOML 三种格式配置文件&lt;/code&gt;&lt;/pre&gt;&lt;h3 id="配置主题"&gt;配置主题&lt;a class="anchor" href="#%e9%85%8d%e7%bd%ae%e4%b8%bb%e9%a2%98"&gt;#&lt;/a&gt;&lt;/h3&gt;&#10;&lt;p&gt;当通过上文命令创建我们的站点后，需要进行主题配置，Hugo 社区有了很丰富的主题，可以通过官网 Themes 菜单选择自己喜欢的风格，查看预览效果，选择后可以进入主题项目仓库，一般都会有很详细的安装及配置说明。&lt;/p&gt;&#10;&lt;p&gt;官方主题网站: &lt;a href="https://themes.gohugo.io/"&gt;https://themes.gohugo.io/&lt;/a&gt;&lt;/p&gt;</description></item><item><title>Git Note</title><link>http://0.0.0.0:1313/posts/note/git/git-note/</link><pubDate>Tue, 04 Jun 2024 20:39:20 +0800</pubDate><guid>http://0.0.0.0:1313/posts/note/git/git-note/</guid><description>&lt;h1 id="访问问题"&gt;访问问题&lt;a class="anchor" href="#%e8%ae%bf%e9%97%ae%e9%97%ae%e9%a2%98"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;h2 id="连接不上"&gt;连接不上&lt;a class="anchor" href="#%e8%bf%9e%e6%8e%a5%e4%b8%8d%e4%b8%8a"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;fatal: unable to access &amp;lsquo;&lt;a href="https://github.com/xxx/.git/"&gt;https://github.com/xxx/.git/&lt;/a&gt;&amp;rsquo;: Failed to connect to github.com port 443 after 21090 ms: Couldn&amp;rsquo;t connect to server&lt;/p&gt;&#10;&lt;h3 id="开启vpn情况"&gt;开启VPN情况&lt;a class="anchor" href="#%e5%bc%80%e5%90%afvpn%e6%83%85%e5%86%b5"&gt;#&lt;/a&gt;&lt;/h3&gt;&#10;&lt;p&gt;一般出现这种问题都是开过VPN导致的本机系统端口号和git的端口号不一致导致的。&lt;/p&gt;&#10;&lt;p&gt;&lt;strong&gt;解决办法：&lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;1.查看本机系统端口号&lt;/p&gt;&#10;&lt;p&gt;设置-&amp;gt;网络和Internet-&amp;gt;代理&lt;/p&gt;&#10;&lt;p&gt;&lt;img src="http://0.0.0.0:1313/pics/git-note/image-20240603100901242.png" alt="image-20240603100901242" /&gt;&lt;/p&gt;&#10;&lt;p&gt;2.设置git端口号和上面的端口号保持一致&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f7f7f7;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;git config --global http.proxy 127.0.0.1:7890&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;git config --global https.proxy 127.0.0.1:7890&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;设置完成可以查看是否配置成功：&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f7f7f7;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&amp;gt; git config --global -l&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;user.email&lt;span style="color:#0550ae"&gt;=&lt;/span&gt;xxx@xx.com&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;user.name&lt;span style="color:#0550ae"&gt;=&lt;/span&gt;xxx&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;http.proxy&lt;span style="color:#0550ae"&gt;=&lt;/span&gt;127.0.0.1:7890&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;https.proxy&lt;span style="color:#0550ae"&gt;=&lt;/span&gt;127.0.0.1:7890&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="未开启vpn情况"&gt;未开启VPN情况&lt;a class="anchor" href="#%e6%9c%aa%e5%bc%80%e5%90%afvpn%e6%83%85%e5%86%b5"&gt;#&lt;/a&gt;&lt;/h3&gt;&#10;&lt;p&gt;还是一样的原因，两边端口不一致导致的，那么直接去掉git代理即可：&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f7f7f7;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;git config --global --unset http.proxy&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;git config --global --unset https.proxy&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id="ssh授权"&gt;SSH授权&lt;a class="anchor" href="#ssh%e6%8e%88%e6%9d%83"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;ol&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;生成密钥&lt;/p&gt;&#10;&lt;blockquote class='book-hint '&gt;&#10;&lt;p&gt;ssh-keygen -t ed25519 -C &amp;ldquo;&lt;a href="mailto:ronybrown741@gmail.com"&gt;ronybrown741@gmail.com&lt;/a&gt;&amp;rdquo; -f $env:USERPROFILE.ssh\id_ed25519_personal&lt;/p&gt;&#10;&lt;/blockquote&gt;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;公钥加到 GitHub&lt;/p&gt;</description></item><item><title/><link>http://0.0.0.0:1313/posts/note/edit/test/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>http://0.0.0.0:1313/posts/note/edit/test/</guid><description/></item></channel></rss>